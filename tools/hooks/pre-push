#!/usr/bin/env bash
# stdin, one line per pushed ref: <local-ref> <local-oid> <remote-ref> <remote-oid> (githooks(5)).
# A deleted ref arrives with an all-zero local oid and adds nothing; the gate skips it.

gate="$(git rev-parse --show-toplevel)/tools/scrub-gate.sh"
refused=0
while read -r local_ref local_oid remote_ref remote_oid; do
    "$gate" --range "$remote_oid" "$local_oid" < /dev/null || refused=1
done
exit "$refused"
