#!/usr/bin/env bash
# Runs the scrub gate, then the conventions lint, on what is being committed. Either one failing
# refuses the commit, and a `pre-commit: refused by ...` line names which.
#
# The lint judges the index: the staged tree is exported to a scratch directory, and the staged
# lint.py runs there with the staged allowlist. An index with no tests/conventions/lint.py (a
# repository without the lint, or a commit that deletes it) skips it and says so. Scratch space is
# under ${TMPDIR:-/tmp}, as the scrub gate's is.
top="$(git rev-parse --show-toplevel)"
status=0

if ! "$top/tools/scrub-gate.sh" --cached; then
    echo "pre-commit: refused by the scrub gate" >&2
    status=1
fi

if git cat-file -e :tests/conventions/lint.py 2> /dev/null; then
    staged="$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX")" || { echo "pre-commit: refused by the conventions lint: no scratch directory" >&2; exit 1; }
    trap 'rm -rf "$staged"' EXIT
    if ! git checkout-index -a --ignore-skip-worktree-bits --prefix="$staged/" ||
        ! python3 "$staged/tests/conventions/lint.py" --root="$staged" \
            --allowlist="$staged/tests/conventions/allowlist.txt"; then
        echo "pre-commit: refused by the conventions lint" >&2
        status=1
    fi
else
    echo "pre-commit: no tests/conventions/lint.py staged; the conventions lint is skipped" >&2
fi

exit "$status"
